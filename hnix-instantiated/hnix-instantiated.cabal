cabal-version:  3.0
name:           hnix-instantiated
version:        0.17.0
synopsis:       HNix core instantiated with HashMap/Vector implementations
description:    Instantiates hnix-core with concrete data structure implementations
                using Backpack mixins. This demonstrates the modular architecture.
category:       System, Data, Nix
license:        BSD-3-Clause
license-file:   ../License
build-type:     Simple

flag strict
  description: Enable Strict language extension globally
  manual: True
  default: True

library
  default-language: Haskell2010
  default-extensions:
      NoImplicitPrelude
    , OverloadedStrings
    , DeriveGeneric
    , FlexibleContexts
    , FlexibleInstances
    , ScopedTypeVariables
    , TypeApplications
    , LambdaCase
    , BangPatterns
  if flag(strict)
    default-extensions:
      Strict
  exposed-modules:
    Nix.Instantiated
  hs-source-dirs:
    src
  build-depends:
      base >= 4.12 && < 5
    , hnix-types
    , hnix-core
    , hnix-attrset-hashmap
    , hnix-list-vector
    , relude >= 1.0.0
  -- Backpack mixins: map signatures to implementations
  mixins:
    hnix-core
      requires
        (Nix.AttrSet.Sig as Nix.AttrSet.HashMap,
         Nix.List.Sig as Nix.List.Vector)
  ghc-options:
    -Wall
