cabal-version:  3.0
name:           hnix-core
version:        0.17.0
synopsis:       Core HNix evaluation library (indefinite Backpack package)
description:    Core evaluation and expression types for HNix.
                This is an indefinite Backpack package that depends on
                abstract AttrSet and NixList signatures, allowing
                compile-time selection of implementations.
category:       System, Data, Nix
license:        BSD-3-Clause
license-file:   ../License
build-type:     Simple

flag strict
  description: Enable Strict language extension globally
  manual: True
  default: True

library
  default-language: Haskell2010
  default-extensions:
      NoImplicitPrelude
    , OverloadedStrings
    , DeriveGeneric
    , DeriveDataTypeable
    , DeriveFunctor
    , DeriveFoldable
    , DeriveTraversable
    , DeriveLift
    , FlexibleContexts
    , FlexibleInstances
    , ScopedTypeVariables
    , StandaloneDeriving
    , TypeApplications
    , TypeSynonymInstances
    , InstanceSigs
    , MultiParamTypeClasses
    , TupleSections
    , LambdaCase
    , BangPatterns
    , ViewPatterns
  if flag(strict)
    default-extensions:
      Strict
  -- Backpack signatures this package requires
  signatures:
    Nix.AttrSet.Sig
    Nix.List.Sig
  exposed-modules:
    Nix.Core.AttrSet
    Nix.Core.List
    Nix.Core.Expr.Types
  hs-source-dirs:
    src
  build-depends:
      base >= 4.12 && < 5
    , deepseq >= 1.4.3
    , hashable >= 1.2.5
    , hnix-types
    , hnix-attrset-sig
    , hnix-list-sig
    , relude >= 1.0.0
  ghc-options:
    -Wall
    -Wno-incomplete-uni-patterns
