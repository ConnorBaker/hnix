cabal-version:  3.4
name:           hnix
version:        0.17.0
synopsis:       Haskell implementation of the Nix language
description:    Haskell implementation of the Nix language.
category:       System, Data, Nix
homepage:       https://github.com/haskell-nix/hnix#readme
bug-reports:    https://github.com/haskell-nix/hnix/issues
author:         John Wiegley
maintainer:     johnw@newartisans.com
license:        BSD-3-Clause
license-file:   License
build-type:     Simple
data-dir:       data/
data-files:
  nix/corepkgs/fetchurl.nix
extra-source-files:
  ChangeLog.md
  ReadMe.md
  License
  -- Test data: Nix language tests from upstream
  data/nix/tests/lang/**/*.nix
  data/nix/tests/lang/**/*.exp
  data/nix/tests/lang/**/*.exp.xml
  data/nix/tests/lang/**/*.exp.disabled
  data/nix/tests/lang/**/*.exp-disabled
  data/nix/tests/lang/**/*.flags
  data/nix/tests/lang/binary-data
  data/nix/tests/lang/data
  data/nix/tests/lang/readDir/bar
  data/nix/tests/lang/readDir/foo/git-hates-directories
  -- Test data: HNix-specific test files
  data/*.nix
  tests/eval-compare/*.nix
  tests/files/*.nix

source-repository head
  type: git
  location: https://github.com/haskell-nix/hnix

flag optimize
  description: Enable all optimization flags
  manual: True
  default: True

flag profiling
  description: Enable profiling
  manual: True
  default: False

flag strict
  description: Enable Strict language extension globally (for performance testing)
  manual: True
  default: True

-- ═══════════════════════════════════════════════════════════════════════════
-- COMMON STANZAS
-- ═══════════════════════════════════════════════════════════════════════════

common shared
  default-language: GHC2024
  -- GHC2024 enables: BangPatterns, BinaryLiterals, ConstraintKinds, DataKinds,
  -- DeriveDataTypeable, DeriveFoldable, DeriveFunctor, DeriveGeneric, DeriveLift,
  -- DeriveTraversable, DerivingStrategies, ExistentialQuantification, FlexibleContexts,
  -- FlexibleInstances, GADTs, GeneralizedNewtypeDeriving, InstanceSigs, KindSignatures,
  -- LambdaCase, MonoLocalBinds, MultiParamTypeClasses, NamedFieldPuns, PolyKinds,
  -- RankNTypes, ScopedTypeVariables, StandaloneDeriving, TupleSections,
  -- TypeApplications, TypeOperators, TypeSynonymInstances, and more.
  default-extensions:
      NoImplicitPrelude
    , OverloadedStrings
    -- Common extensions not in GHC2024:
    , TypeFamilies
    , AllowAmbiguousTypes
    , UndecidableInstances
    , ViewPatterns
  build-depends:
      base >= 4.12 && < 5
    , data-default-class >= 0.1.2
    , data-fix >= 0.3.0
    , exceptions >= 0.10.0
    , filepath >= 1.4.2
    , optparse-applicative >= 0.14.3
    , reflection >= 2.1.6
    , relude >= 1.0.0
    , serialise >= 0.2.1
    , singleton-bool >= 0.1.5
    , ghc
    , template-haskell >= 2.13
    , time >= 1.9.3
    , unix >= 2.7
  ghc-options:
    -Wall
    -Wno-incomplete-uni-patterns
    -fprint-potential-instances
    -- TODO(@connorbaker): Debugging/performance
    -Wall-missed-specialisations
    -- -flate-specialise
    -- -fpolymorphic-specialisation
  if flag(optimize)
    default-extensions:
      ApplicativeDo
  if flag(strict)
    default-extensions:
      Strict

-- Minimal common stanza for sublibraries (less dependencies)
common shared-sublibrary
  default-language: GHC2024
  default-extensions:
      NoImplicitPrelude
    , OverloadedStrings
    -- Common extensions not in GHC2024:
    , TypeFamilies
    , AllowAmbiguousTypes
    , UndecidableInstances
    , ViewPatterns
  ghc-options:
    -Wall
    -Wno-incomplete-uni-patterns
  if flag(strict)
    default-extensions:
      Strict

-- ═══════════════════════════════════════════════════════════════════════════
-- FOUNDATIONAL SUBLIBRARY
-- ═══════════════════════════════════════════════════════════════════════════

library hnix-types
  import: shared-sublibrary
  visibility: public
  hs-source-dirs: types
  exposed-modules:
    Nix.Types.Atom
    Nix.Types.Path
    Nix.Types.SourcePos
    Nix.Types.VarName
    Nix.Types.VarName.Static
  build-depends:
      base >= 4.12 && < 5
    , aeson >= 2.0
    , binary >= 0.8.5
    , data-default-class >= 0.1.2
    , deepseq >= 1.4.3
    , filepath >= 1.4.2
    , hashable >= 1.2.5
    , megaparsec >= 7.0
    , relude >= 1.0.0
    , serialise >= 0.2.1
    , ghc
    , template-haskell >= 2.13
    , text >= 1.2.3

-- ═══════════════════════════════════════════════════════════════════════════
-- SIGNATURE SUBLIBRARIES
-- ═══════════════════════════════════════════════════════════════════════════

library hnix-attrset-sig
  import: shared-sublibrary
  visibility: public
  signatures: Nix.AttrSet.Sig
  hs-source-dirs: signatures
  build-depends:
      base >= 4.12 && < 5
    , hnix:hnix-types
    , aeson >= 2.0
    , binary >= 0.8
    , deepseq >= 1.4.3
    , hashable >= 1.3.0
    , indexed-traversable >= 0.1.1
    , semialign >= 1.2
    , serialise >= 0.2

library hnix-list-sig
  import: shared-sublibrary
  visibility: public
  signatures: Nix.List.Sig
  hs-source-dirs: signatures
  build-depends:
      base >= 4.12 && < 5
    , deepseq >= 1.4.3
    , hashable >= 1.3.0
    , semialign >= 1.2

library hnix-string-sig
  import: shared-sublibrary
  visibility: public
  signatures: Nix.String.Sig
  hs-source-dirs: signatures
  build-depends:
      base >= 4.12 && < 5
    , hnix:hnix-types
    , deepseq >= 1.4.3
    , hashable >= 1.3.0
    , text >= 1.2
    , unordered-containers >= 0.2.14

-- ═══════════════════════════════════════════════════════════════════════════
-- IMPLEMENTATION SUBLIBRARIES
-- ═══════════════════════════════════════════════════════════════════════════

library hnix-attrset
  import: shared-sublibrary
  visibility: public
  hs-source-dirs: implementations/attrset
  exposed-modules: Nix.AttrSet.HashMap
  build-depends:
      base >= 4.12 && < 5
    , hnix:hnix-types
    , aeson >= 2.0
    , binary >= 0.8
    , deepseq >= 1.4.3
    , hashable >= 1.3.0
    , indexed-traversable >= 0.1.1
    , relude >= 1.0.0
    , semialign >= 1.2
    , serialise >= 0.2
    , template-haskell >= 2.12
    , unordered-containers >= 0.2.14

-- Vector-based AttrSet implementation (alternative to HashMap)
library hnix-attrset-vector
  import: shared-sublibrary
  visibility: public
  hs-source-dirs: implementations/attrset-vector
  exposed-modules: Nix.AttrSet.Vector
  build-depends:
      base >= 4.12 && < 5
    , hnix:hnix-types
    , aeson >= 2.0
    , binary >= 0.8
    , deepseq >= 1.4.3
    , hashable >= 1.3.0
    , indexed-traversable >= 0.1.1
    , relude >= 1.0.0
    , semialign >= 1.2
    , serialise >= 0.2
    , template-haskell >= 2.12
    , these >= 1.1
    , vector >= 0.12

-- FastStringEnv-based AttrSet implementation (GHC's UniqFM with FastString keys)
library hnix-attrset-faststring
  import: shared-sublibrary
  visibility: public
  hs-source-dirs: implementations/attrset-faststring
  exposed-modules: Nix.AttrSet.FastStringEnv
  build-depends:
      base >= 4.12 && < 5
    , hnix:hnix-types
    , aeson >= 2.0
    , binary >= 0.8
    , deepseq >= 1.4.3
    , ghc
    , hashable >= 1.3.0
    , indexed-traversable >= 0.1.1
    , relude >= 1.0.0
    , semialign >= 1.2
    , serialise >= 0.2
    , template-haskell >= 2.12
    , these >= 1.1

-- Internal library for list (no unfilled signatures)
library hnix-list-internal
  import: shared-sublibrary
  visibility: private
  hs-source-dirs: implementations/list
  exposed-modules: Nix.List.Vector
  build-depends:
      base >= 4.12 && < 5
    , deepseq >= 1.4.3
    , hashable >= 1.3.0
    , relude >= 1.0.0
    , semialign >= 1.2
    , these >= 1.1
    , vector >= 0.12.0

-- Public library for list (re-exports internal, no signatures needed)
library hnix-list
  import: shared-sublibrary
  visibility: public
  reexported-modules: Nix.List.Vector
  build-depends:
      base >= 4.12 && < 5
    , hnix:hnix-list-internal

-- Internal library for string (no unfilled signatures)
library hnix-string-internal
  import: shared-sublibrary
  visibility: private
  hs-source-dirs: implementations/string
  exposed-modules:
    Nix.String.Text
    Nix.String.Text.Context
  build-depends:
      base >= 4.12 && < 5
    , hnix:hnix-types
    , deepseq >= 1.4.3
    , hashable >= 1.3.0
    , mtl >= 2.2.2
    , relude >= 1.0.0
    , text >= 1.2
    , unordered-containers >= 0.2.14

-- Public library for string (has unfilled AttrSet.Sig for NixLike)
library hnix-string
  import: shared-sublibrary
  visibility: public
  hs-source-dirs: implementations/string-public
  signatures: Nix.AttrSet.Sig
  exposed-modules: Nix.String.Text.NixLike
  reexported-modules:
    Nix.String.Text
    , Nix.String.Text.Context
  build-depends:
      base >= 4.12 && < 5
    , hnix:hnix-types
    , hnix:hnix-attrset-sig
    , hnix:hnix-string-internal
    , deepseq >= 1.4.3
    , hashable >= 1.3.0
    , relude >= 1.0.0
    , text >= 1.2
    , unordered-containers >= 0.2.14

-- ═══════════════════════════════════════════════════════════════════════════
-- INDEFINITE SUBLIBRARIES (require signature instantiation)
-- ═══════════════════════════════════════════════════════════════════════════

-- Merged hnix-core: contains both core types AND value system
library hnix-core
  import: shared-sublibrary
  visibility: public
  hs-source-dirs: core
  signatures:
    Nix.AttrSet.Sig
    Nix.List.Sig
    Nix.String.Sig
  exposed-modules:
    -- Core types and utilities
    Nix.Core.AttrSet
    Nix.Core.List
    Nix.Core.Expr.Types
    Nix.Core.Scope
    Nix.Core.Types
    Nix.Core.Utils
    -- Value system (from hnix-value-core, renamed)
    Nix.Core.Value
    Nix.Core.Value.Equal
    Nix.Core.Value.Frames
    Nix.Core.Value.Interned
    Nix.Core.Value.Monad
    Nix.Core.Value.Protocol
    Nix.Core.Value.String
    Nix.Core.Value.Thunk
    Nix.Core.Value.Thunk.Basic
  build-depends:
      base >= 4.12 && < 5
    , hnix:hnix-types
    , hnix:hnix-attrset-sig
    , hnix:hnix-list-sig
    , hnix:hnix-string-sig
    , aeson >= 1.4.2
    , comonad >= 5.0.8
    , deepseq >= 1.4.3
    , exceptions >= 0.10.0
    , free >= 5.1
    , hashable >= 1.2.5
    , lens-family >= 1.2.2
    , lens-family-core >= 1.2.2
    , lens-family-th >= 0.5.0.2
    , mtl >= 2.2.2
    , ref-tf >= 0.5
    , reflection >= 2.1.6
    , relude >= 1.0.0
    , semialign >= 1.2
    , text >= 1.2.3
    , these >= 1.1
    , transformers >= 0.5.5
    , unordered-containers >= 0.2.14

library hnix-builtins-list
  import: shared-sublibrary
  visibility: public
  hs-source-dirs: builtins/list
  default-extensions:
    ConstraintKinds
    AllowAmbiguousTypes
  signatures:
    Nix.AttrSet.Sig
    Nix.List.Sig
    Nix.String.Sig
  exposed-modules: Nix.Builtins.List
  build-depends:
      base >= 4.12 && < 5
    , hnix:hnix-types
    , hnix:hnix-attrset-sig
    , hnix:hnix-list-sig
    , hnix:hnix-string-sig
    , hnix:hnix-core
    , exceptions >= 0.10.0
    , relude >= 1.0.0
    , text >= 1.2
  ghc-options:
    -Wno-name-shadowing

library hnix-builtins-attrset
  import: shared-sublibrary
  visibility: public
  hs-source-dirs: builtins/attrset
  default-extensions:
    ConstraintKinds
    AllowAmbiguousTypes
  signatures:
    Nix.AttrSet.Sig
    Nix.List.Sig
    Nix.String.Sig
  exposed-modules: Nix.Builtins.AttrSet
  build-depends:
      base >= 4.12 && < 5
    , hnix:hnix-types
    , hnix:hnix-attrset-sig
    , hnix:hnix-list-sig
    , hnix:hnix-string-sig
    , hnix:hnix-core
    , exceptions >= 0.10.0
    , relude >= 1.0.0
    , text >= 1.2
  ghc-options:
    -Wno-name-shadowing

-- ═══════════════════════════════════════════════════════════════════════════
-- MAIN LIBRARY (instantiates all signatures via mixins)
-- ═══════════════════════════════════════════════════════════════════════════

library
  import: shared
  -- Backpack mixins: instantiate all indefinite packages with concrete implementations.
  mixins:
    hnix:hnix-core
      requires
        (Nix.AttrSet.Sig as Nix.AttrSet.FastStringEnv,
         Nix.List.Sig as Nix.List.Vector,
         Nix.String.Sig as Nix.String.Text),
    hnix:hnix-string
      requires
        (Nix.AttrSet.Sig as Nix.AttrSet.FastStringEnv),
    hnix:hnix-builtins-list
      requires
        (Nix.AttrSet.Sig as Nix.AttrSet.FastStringEnv,
         Nix.List.Sig as Nix.List.Vector,
         Nix.String.Sig as Nix.String.Text),
    hnix:hnix-builtins-attrset
      requires
        (Nix.AttrSet.Sig as Nix.AttrSet.FastStringEnv,
         Nix.List.Sig as Nix.List.Vector,
         Nix.String.Sig as Nix.String.Text)
  -- Re-export instantiated Backpack modules so dependents can import them
  reexported-modules:
    Nix.Core.AttrSet
    , Nix.Core.List
  exposed-modules:
    Nix
    Nix.Prelude
    Nix.Utils
    Nix.Atoms
    Nix.Builtins
    Nix.Builtins.Arithmetic
    Nix.Builtins.AttrSet
    Nix.Builtins.Context
    Nix.Builtins.Control
    Nix.Builtins.Fetch
    Nix.Builtins.Internal
    Nix.Builtins.List
    Nix.Builtins.Path
    Nix.Builtins.String
    Nix.Builtins.Type
    Nix.Cache
    Nix.Config.Singleton
    Nix.Cited
    Nix.Cited.Basic
    Nix.Context
    Nix.Convert
    Nix.Effects
    Nix.Effects.Basic
    Nix.Effects.Derivation
    Nix.Eval
    Nix.EvalStats
    Nix.Exec
    Nix.Expr
    Nix.Expr.Desugar
    Nix.Expr.Shorthands
    Nix.Expr.Strings
    Nix.Expr.Types
    Nix.Expr.Types.Annotated
    Nix.Frames
    Nix.FileType
    Nix.Fresh
    Nix.Fresh.Basic
    Nix.Json
    Nix.List
    Nix.Normal
    Nix.Options
    Nix.Options.Parser
    Nix.Parser
    Nix.Pretty
    Nix.Reduce
    Nix.Render
    Nix.Render.Frame
    Nix.Scope
    Nix.Store.Overlay
    Nix.Standard
    Nix.String
    Nix.String.Coerce
    Nix.Thunk
    Nix.Thunk.Basic
    Nix.Utils.Fix1
    Nix.Value
    Nix.Value.Equal
    Nix.Value.Interned
    Nix.Value.Monad
    Nix.XML
  other-modules:
    Paths_hnix
  autogen-modules:
    Paths_hnix
  hs-source-dirs:
    src
  build-depends:
      aeson >= 2.0
    , array >= 0.4
    -- Sublibraries (implementations provide modules, indefinite packages get instantiated via mixins)
    , hnix:hnix-types
    , hnix:hnix-attrset-faststring
    , hnix:hnix-list
    , hnix:hnix-string
    , hnix:hnix-core
    , hnix:hnix-builtins-list
    , hnix:hnix-builtins-attrset
    , base16-bytestring >= 0.1.1
    , binary >= 0.8.5
    , bytestring >= 0.10.8
    , crypton-connection
    , crypton
    , memory
    , comonad >= 5.0.4
    , containers >= 0.5.11.0
    , deepseq >= 1.4.3
    , dependent-sum >= 0.7
    , deriving-compat >= 0.3
    , directory >= 1.3.1
    , extra >= 1.7
    , free >= 5.1
    , gitrev >= 1.1.0
    , hashable >= 1.2.5
    , hnix-store-core >= 0.6.0
    , hnix-store-nar >= 0.1.0
    , hnix-store-remote >= 0.6.0
    , hnix-store-readonly >= 0.1.0
    , http-client >= 0.6.4
    , http-client-tls >= 0.3.5
    , http-types >= 0.12.2
    , lens-family >= 1.2.2
    , lens-family-core >= 1.2.2
    , lens-family-th >= 0.5.0
    , megaparsec >= 7.0
    , monad-control >= 1.0.2
    , monadlist >= 0.0.2
    , mtl >= 2.2.2
    , neat-interpolation >= 0.4
    , parser-combinators >= 1.0.1
    , pretty-show >= 1.9.5
    , prettyprinter >= 1.7.0
    , process >= 1.6.3
    , ref-tf >= 0.5
    , regex-tdfa >= 1.2.3
    , scientific >= 0.3.6
    , semialign >= 1.2
    , some >= 1.0.1
    , split >= 0.2.3
    , syb >= 0.7
    , temporary >= 1.3
    -- provides:
    --   * compat instances for old versions of TH for old GHCs
    --   * orphan instances for TH missing instances
    -- aka Lift Text, Bytestring, Vector, Containers,
    -- we use Lift Text particulrarly for GHC 8.6
    , th-lift-instances >= 0.1
    , text >= 1.2.3
    , these >= 1.0.1
    , transformers >= 0.5.5
    , transformers-base >= 0.4.5
    , tls
    , toml-parser >= 2.0.0.0
    , unix-compat >= 0.4.3
    , unordered-containers >= 0.2.14
    , vector >= 0.12.0
    , xml >= 1.3.14

executable hnix
  import: shared
  hs-source-dirs:
    main
  main-is: Main.hs
  other-modules:
    Repl
    Paths_hnix
  autogen-modules:
    Paths_hnix
  build-depends:
      hnix
    , hnix:hnix-types
    , aeson
    , aeson-pretty
    , comonad
    , containers
    , deepseq
    , free
    , haskeline >= 0.8.0.0
    , pretty-show
    , prettyprinter
    , ref-tf
    , repline >= 0.4.0.0
  ghc-options:
    -rtsopts
  if impl(ghc < 8.10)
    -- GHC < 8.10 comes with haskeline < 0.8, which we don't support.
    -- To simplify CI, we just disable the component.
    buildable: False

test-suite hnix-tests
  import: shared
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
    EvalTests
    InternedValueTests
    NixLanguageTests
    ParserTests
    PrettyParseTests
    PrettyTests
    ReduceExprTests
    TestCommon
  hs-source-dirs:
    tests
  build-depends:
      hnix
    , Diff
    , Glob
    , containers
    , directory
    , hedgehog
    , megaparsec
    , neat-interpolation
    , pretty-show
    , prettyprinter
    , process
    , split
    , tasty
    , tasty-hedgehog
    , tasty-hunit
    , tasty-th
    , unix-compat

-- benchmark hnix-benchmarks

benchmark hnix-weigh
