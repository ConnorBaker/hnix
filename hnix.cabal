    Inspection.Config
    Inspection.Convert
    Inspection.Functor
    Inspection.HasCitations
    Inspection.Integration
    Inspection.MonadThunk
    Inspection.NixString
    Inspection.Protocol
    Inspection.Scope
    Inspection.Singleton
    Inspection.Thunk
    Inspection.Types
    Inspection.Value
  hs-source-dirs:
    tests/inspection
  build-depends:
      hnix
    , comonad
    , free
    , inspection-testing
    , template-haskell
    , vector
