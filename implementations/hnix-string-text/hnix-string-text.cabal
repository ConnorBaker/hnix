cabal-version:  3.0
name:           hnix-string-text
version:        0.17.0
synopsis:       Text implementation for HNix NixString signature
description:    Provides a Text-backed implementation of the NixString signature.
                Uses Data.Text for string content and HashSet for context tracking.
                .
                The package has a two-tier structure:
                .
                * Internal library (hnix-string-text-internal): Core NixString
                  implementation with no unfilled signatures.
                .
                * Public library: Re-exports internal library plus NixLikeContext
                  which requires Nix.AttrSet.Sig for Nix-compatible context handling.
category:       System, Data, Nix
license:        BSD-3-Clause
license-file:   ../../License
build-type:     Simple

flag strict
  description: Enable Strict language extension globally
  manual: True
  default: True

-- Internal library: no unfilled signatures.
-- Contains core NixString + StringContext + WithStringContextT.
library hnix-string-text-internal
  default-language: Haskell2010
  default-extensions:
      NoImplicitPrelude
    , OverloadedStrings
    , DeriveGeneric
    , DeriveFunctor
    , DeriveFoldable
    , DeriveTraversable
    , FlexibleContexts
    , FlexibleInstances
    , ScopedTypeVariables
    , TypeApplications
    , LambdaCase
    , BangPatterns
  if flag(strict)
    default-extensions:
      Strict
  exposed-modules:
    Nix.String.Text
    Nix.String.Text.Context
  hs-source-dirs:
    src
  build-depends:
      base >= 4.12 && < 5
    , deepseq >= 1.4.3
    , hashable >= 1.3.0
    , hnix-types
    , mtl >= 2.2.2
    , relude >= 1.0.0
    , text >= 1.2
    , unordered-containers >= 0.2.14
  ghc-options:
    -Wall

-- Public library: re-exports internal + NixLike (needs AttrSet.Sig).
library
  default-language: Haskell2010
  default-extensions:
      NoImplicitPrelude
    , OverloadedStrings
    , DeriveGeneric
    , DeriveFunctor
    , DeriveFoldable
    , DeriveTraversable
    , FlexibleContexts
    , FlexibleInstances
    , ScopedTypeVariables
    , TypeApplications
    , LambdaCase
    , BangPatterns
  if flag(strict)
    default-extensions:
      Strict
  -- AttrSet.Sig is left abstract (will be filled by the final consumer)
  signatures:
    Nix.AttrSet.Sig
  mixins:
    -- Bring internal library's modules into scope
    hnix-string-text-internal
  reexported-modules:
    Nix.String.Text
    , Nix.String.Text.Context
  exposed-modules:
    Nix.String.Text.NixLike
  hs-source-dirs:
    src-public
  build-depends:
      base >= 4.12 && < 5
    , deepseq >= 1.4.3
    , hashable >= 1.3.0
    , hnix-attrset-sig
    , hnix-string-text-internal
    , hnix-types
    , relude >= 1.0.0
    , text >= 1.2
    , unordered-containers >= 0.2.14
  ghc-options:
    -Wall
