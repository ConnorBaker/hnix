cabal-version:  3.0
name:           hnix-list-vector
version:        0.17.0
synopsis:       Vector implementation for HNix NixList signature
description:    Provides a Vector-backed implementation of the NixList signature.
                Offers O(1) length and indexing, ideal for Nix list operations.

                NOTE: The Nix.List.Vector.Builtins module is not currently exposed
                due to Backpack cycle restrictions. Builtins remain in the main
                hnix library (Nix.Builtins.List). A future refactoring that moves
                the value infrastructure to a separate package would enable
                swappable list builtins.
category:       System, Data, Nix
license:        BSD-3-Clause
license-file:   ../../License
build-type:     Simple

flag strict
  description: Enable Strict language extension globally
  manual: True
  default: True

library
  default-language: Haskell2010
  default-extensions:
      NoImplicitPrelude
    , OverloadedStrings
    , DeriveGeneric
    , DeriveFunctor
    , DeriveFoldable
    , DeriveTraversable
    , FlexibleContexts
    , FlexibleInstances
    , ScopedTypeVariables
    , TypeApplications
    , LambdaCase
    , BangPatterns
  if flag(strict)
    default-extensions:
      Strict
  -- NOTE: Nix.List.Vector.Builtins requires Nix.Value.Protocol signature.
  -- Due to Backpack cycle restrictions, we don't expose that module here.
  -- The builtins source is kept for future use when the value infrastructure
  -- is refactored into a separate package.
  exposed-modules:
    Nix.List.Vector
  -- other-modules:
  --   Nix.List.Vector.Builtins
  hs-source-dirs:
    src
  build-depends:
      base >= 4.12 && < 5
    , deepseq >= 1.4.3
    , hashable >= 1.3.0
    , relude >= 1.0.0
    , semialign >= 1.2
    , these >= 1.1
    , vector >= 0.12.0
  ghc-options:
    -Wall
