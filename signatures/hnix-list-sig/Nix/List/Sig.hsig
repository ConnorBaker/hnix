-- | Backpack signature for NixList operations.
--
-- This signature defines the abstract interface for lists in HNix.
-- Function names match Nix's builtin list operations where applicable.
-- Implementations can provide Vector, Seq, or regular lists while
-- guaranteeing monomorphization at link time (no dictionary passing).
--
-- Note: For pure folds, use the Foldable instance (foldl', foldr, etc.)
-- The monadic versions here are for Nix builtins that take Nix closures.
signature Nix.List.Sig where

import Control.DeepSeq (NFData)
import Data.Functor.Classes (Eq1, Show1)
import Data.Hashable (Hashable)
import Data.Semialign (Align, Semialign)

-- | Abstract list type for Nix list values.
-- The concrete implementation is selected at link time via Backpack mixins.
data NixList a

-- * Nix builtin equivalents (monadic)
-- These are for Nix builtins that take Nix closures as arguments.

-- | Monadic filter by a predicate. For @builtins.filter@.
filterM :: Monad m => (a -> m Bool) -> NixList a -> m (NixList a)

-- | Strict monadic left fold. For @builtins.foldl'@.
foldM' :: Monad m => (b -> a -> m b) -> b -> NixList a -> m b

-- | Monadic generation of a list. For @builtins.genList@.
genListM :: Monad m => Int -> (Int -> m a) -> m (NixList a)

-- | Partition a list by a monadic predicate. For @builtins.partition@.
partitionM :: Monad m => (a -> m Bool) -> NixList a -> m (NixList a, NixList a)

-- * Core operations

-- | The empty list.
empty :: NixList a

-- | Check if the list is empty.
null :: NixList a -> Bool

-- | Get the length of the list.
length :: NixList a -> Int

-- | Safe indexing by position. Equivalent to @builtins.elemAt@.
-- Returns Nothing if index is out of bounds.
elemAt :: NixList a -> Int -> Maybe a

-- | Unsafe indexing by position.
-- Behavior undefined if index is out of bounds.
unsafeElemAt :: NixList a -> Int -> a

-- | Get the first element. Equivalent to @builtins.head@.
-- Returns Nothing if empty.
head :: NixList a -> Maybe a

-- | Get all elements except the first. Equivalent to @builtins.tail@.
-- Returns Nothing if empty.
tail :: NixList a -> Maybe (NixList a)

-- | Unsafe tail - undefined behavior if list is empty.
unsafeTail :: NixList a -> NixList a

-- | Create a singleton list.
singleton :: a -> NixList a

-- | Decompose into head and tail. Returns Nothing if empty.
uncons :: NixList a -> Maybe (a, NixList a)

-- | Prepend an element.
cons :: a -> NixList a -> NixList a

-- | Append an element.
snoc :: NixList a -> a -> NixList a

-- | Concatenate two lists.
append :: NixList a -> NixList a -> NixList a

-- | Build a list from a Haskell list.
fromList :: [a] -> NixList a

-- | Convert to a Haskell list.
toList :: NixList a -> [a]

-- | Reverse the list.
reverse :: NixList a -> NixList a

-- * Required instances
-- Use Foldable for foldl', foldr, foldr', length, null, etc.
-- Use Traversable for traverse.
-- Use Functor for fmap.

instance Functor NixList
instance Foldable NixList
instance Traversable NixList
instance Eq a => Eq (NixList a)
instance Eq1 NixList
instance Ord a => Ord (NixList a)
instance Show a => Show (NixList a)
instance Show1 NixList
instance Semigroup (NixList a)
instance Monoid (NixList a)
instance NFData a => NFData (NixList a)
instance Hashable a => Hashable (NixList a)
instance Semialign NixList
instance Align NixList
