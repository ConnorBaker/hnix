-- | Backpack signature for NixString operations.
--
-- This signature defines the abstract interface for Nix strings with context
-- tracking in HNix. Nix strings carry "context" - information about which
-- store paths or derivations they reference. This context propagates through
-- string operations to ensure proper dependency tracking.
--
-- Implementations can provide different backing stores for the string content
-- (Text, ByteString, ShortText) while guaranteeing monomorphization at link
-- time (no dictionary passing).
--
-- NOTE: NixLikeContext, WithStringContextT, and conversion functions stay
-- in the implementation package because they depend on AttrSet.
--
-- NOTE: Pattern synonyms are not supported in Backpack signatures, so
-- ContextFlavor is exposed as an opaque type with smart constructors and
-- a pattern-matching function.
signature Nix.String.Sig where

import Control.DeepSeq (NFData)
import Data.Hashable (Hashable)
import Data.HashSet (HashSet)
import Data.Text (Text)
import Nix.Types.VarName (VarName)

-- * Context types

-- | A Nix 'StringContext' tracks where string values come from.
-- This is used for proper dependency tracking in the Nix store.
data StringContext

-- | Accessor: get the flavor of the context
getStringContextFlavor :: StringContext -> ContextFlavor

-- | Accessor: get the path of the context
getStringContextPath :: StringContext -> VarName

-- | Constructor for StringContext
mkStringContext :: ContextFlavor -> VarName -> StringContext

instance Eq StringContext
instance Ord StringContext
instance Show StringContext
instance Hashable StringContext
instance NFData StringContext

-- | A 'ContextFlavor' describes the type of derivation reference.
-- This is an opaque type with smart constructors.
data ContextFlavor

instance Eq ContextFlavor
instance Ord ContextFlavor
instance Show ContextFlavor
instance Hashable ContextFlavor
instance NFData ContextFlavor

-- | Smart constructor for direct path context (most common - store paths)
mkDirectPath :: ContextFlavor

-- | Smart constructor for all outputs context (derivation paths referencing all outputs)
mkAllOutputs :: ContextFlavor

-- | Smart constructor for specific derivation output context
mkDerivationOutput :: Text -> ContextFlavor

-- | Check if a ContextFlavor is DirectPath
isDirectPath :: ContextFlavor -> Bool

-- | Check if a ContextFlavor is AllOutputs
isAllOutputs :: ContextFlavor -> Bool

-- | Check if a ContextFlavor is DerivationOutput
isDerivationOutput :: ContextFlavor -> Bool

-- | Extract the output name from a DerivationOutput flavor.
-- Returns Nothing for other flavors.
getDerivationOutputName :: ContextFlavor -> Maybe Text

-- * NixString type

-- | Abstract Nix string type with context tracking.
-- The concrete implementation is selected at link time via Backpack mixins.
data NixString

instance Eq NixString
instance Ord NixString
instance Show NixString
instance Semigroup NixString
instance Monoid NixString
instance Hashable NixString
instance NFData NixString

-- * Construction

-- | Constructs NixString without a context.
-- Use this for string literals and other strings that don't reference store paths.
mkNixStringWithoutContext :: Text -> NixString

-- | Create NixString from a Text and context set.
mkNixString :: HashSet StringContext -> Text -> NixString

-- | Create NixString using a singleton context.
mkNixStringWithSingletonContext :: StringContext -> VarName -> NixString

-- | Create NixString with DirectPath context.
-- This is the most common context type (for store paths).
mkNixStrDirectPath :: VarName -> NixString

-- | Create NixString with AllOutputs context.
-- Used for derivation paths that reference all outputs.
mkNixStrAllOutputs :: VarName -> NixString

-- * Extraction

-- | Extract the string contents from a NixString even if it has context.
-- WARNING: This discards context information. Use with care.
ignoreContext :: NixString -> Text

-- | Extract the string contents from a NixString that has no context.
-- Returns Nothing if the string has context.
getStringNoContext :: NixString -> Maybe Text

-- | Get the context of a NixString.
getStringContext :: NixString -> HashSet StringContext

-- | Returns True if the NixString has an associated context.
hasContext :: NixString -> Bool

-- * Modification

-- | Modify the string part of the NixString, leaving the context unchanged.
modifyNixContents :: (Text -> Text) -> NixString -> NixString

-- | Combine NixStrings with a separator.
-- Context from both the separator and all elements is combined.
intercalateNixString :: NixString -> [NixString] -> NixString

-- * Constants (for zero-allocation optimization)

-- | Shared empty string context to avoid repeated allocations.
emptyStringContext :: HashSet StringContext

-- | Empty NixString constant (empty text, no context).
-- Use this instead of @mkNixStringWithoutContext ""@ in hot paths.
nixStringEmpty :: NixString

-- | NixString "1" constant (no context).
-- Used for boolean-to-string coercion of True.
nixStringOne :: NixString
