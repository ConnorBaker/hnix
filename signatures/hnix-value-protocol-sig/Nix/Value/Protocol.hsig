-- | Backpack signature for NValue protocol.
--
-- This signature defines the abstract interface for Nix value operations
-- needed by list builtins in hnix-list-vector. Implementations provide
-- their concrete NValue type.
--
-- The key operations are:
-- 1. Extract values from NValue (lists, ints, bools, etc.)
-- 2. Construct NValue from Haskell values
-- 3. Force/defer thunks
-- 4. Call Nix functions
-- 5. Handle errors
--
-- NOTE: This signature depends on hnix-list-sig for the NixList type.
-- This is a one-way dependency (no circular deps).
signature Nix.Value.Protocol where

import Data.Text (Text)
import Nix.List.Sig (NixList)
import Nix.Types.VarName (VarName)
import Nix.Types.Atom (NAtom)
import Nix.Types.Path (Path)

-- * Abstract value type

-- | The abstract Nix value type.
-- Parameterized by:
--   t - the thunk type
--   f - the functor wrapping values (for provenance)
--   m - the evaluation monad
data NValue t f m

-- * Value extraction

-- | Extract a list from an NValue.
-- Returns Nothing if the value is not a list.
extractList :: NValue t f m -> Maybe (NixList (NValue t f m))

-- | Extract an integer from an NValue.
-- Returns Nothing if the value is not an integer.
extractInt :: NValue t f m -> Maybe Integer

-- | Extract a boolean from an NValue.
-- Returns Nothing if the value is not a boolean.
extractBool :: NValue t f m -> Maybe Bool

-- | Extract a string without context from an NValue.
-- Returns Nothing if the value is not a string or has context.
extractStringNoContext :: NValue t f m -> Maybe Text

-- | Extract an attrset from an NValue.
-- Returns Nothing if the value is not an attrset.
-- Returns a list of key-value pairs.
extractAttrSet :: NValue t f m -> Maybe [(VarName, NValue t f m)]

-- * Value construction

-- | Construct an NValue list from a NixList.
mkList :: NixList (NValue t f m) -> NValue t f m

-- | Construct an NValue integer.
mkInt :: Integer -> NValue t f m

-- | Construct an NValue boolean.
mkBool :: Bool -> NValue t f m

-- | Construct an NValue attribute set from a list of key-value pairs.
mkSet :: [(VarName, NValue t f m)] -> NValue t f m

-- | Construct an NValue constant from an atom.
mkConstant :: NAtom -> NValue t f m

-- | Construct an NValue string without context.
mkStringNoContext :: Text -> NValue t f m

-- * Interned singleton values
-- These provide zero-allocation access to common values.

-- | The interned empty list value [].
internedEmptyList :: NValue t f m

-- | The interned empty set value {}.
internedEmptySet :: NValue t f m

-- | Interned true value.
internedTrue :: NValue t f m

-- | Interned false value.
internedFalse :: NValue t f m

-- | Interned null value.
internedNull :: NValue t f m

-- | Get interned boolean by value.
internedBool :: Bool -> NValue t f m

-- * Thunk operations

-- | Force evaluation of a value, returning the WHNF value.
demand :: Monad m => NValue t f m -> m (NValue t f m)

-- | Defer evaluation, creating a thunk.
defer :: Monad m => m (NValue t f m) -> m (NValue t f m)

-- * Function application

-- | Call a Nix function with an argument.
-- The first argument is the function, the second is the argument.
callFunc :: Monad m => NValue t f m -> NValue t f m -> m (NValue t f m)

-- * Error handling

-- | Throw a type error with the given message.
throwTypeError :: Monad m => Text -> m a

-- | Throw an error with a context message for debugging.
-- First argument is the context, second is the actual error.
throwErrorWithContext :: Monad m => Text -> Text -> m a

-- * Attribute set operations

-- | Lookup a key in an attrset value.
-- Returns Nothing if not an attrset or key not found.
lookupAttr :: VarName -> NValue t f m -> Maybe (NValue t f m)

-- * Value equality (for builtins.elem)

-- | Compare two values for equality.
-- Used by builtins.elem for membership testing.
valueEq :: Monad m => NValue t f m -> NValue t f m -> m Bool
