cabal-version:  3.0
name:           hnix-value-protocol-sig
version:        0.17.0
synopsis:       Backpack signature for HNix value protocol
description:    Defines the abstract interface for NValue operations used by
                builtins. Allows list implementations to define Nix builtins
                without depending on the concrete value type.
category:       System, Data, Nix
license:        BSD-3-Clause
license-file:   ../../License
build-type:     Simple

library
  default-language: Haskell2010
  signatures:
    Nix.Value.Protocol
  build-depends:
      base >= 4.12 && < 5
    , hnix-list-sig
    , hnix-types
    , text >= 1.2
  ghc-options:
    -Wall
