cabal-version:  3.0
name:           hnix-value-core
version:        0.17.0
synopsis:       Core value infrastructure for HNix (thunks, frames, strings)
description:    Core value types and typeclasses for HNix that have no upward
                dependencies on evaluation (Nix.Eval, Nix.Exec, Nix.Options).
                This package provides the foundation for the value system:
                thunks, error frames, string contexts, and value monad classes.
                .
                This package is part of the HNix Backpack architecture and
                enables swappable implementations of data structures while
                maintaining zero runtime overhead.
category:       System, Data, Nix
license:        BSD-3-Clause
license-file:   ../License
build-type:     Simple

flag strict
  description: Enable Strict language extension globally
  manual: True
  default: True

library
  default-language: Haskell2010
  default-extensions:
      NoImplicitPrelude
    , OverloadedStrings
    , DeriveGeneric
    , DeriveDataTypeable
    , DeriveFunctor
    , DeriveFoldable
    , DeriveTraversable
    , DeriveLift
    , FlexibleContexts
    , FlexibleInstances
    , ScopedTypeVariables
    , StandaloneDeriving
    , TypeApplications
    , TypeSynonymInstances
    , InstanceSigs
    , MultiParamTypeClasses
    , TupleSections
    , LambdaCase
    , BangPatterns
    , ViewPatterns
  if flag(strict)
    default-extensions:
      Strict
  -- Backpack signatures this package requires
  signatures:
    Nix.AttrSet.Sig
    Nix.List.Sig
    Nix.String.Sig
  exposed-modules:
    Nix.Value.Core.Thunk
    Nix.Value.Core.Thunk.Basic
    Nix.Value.Core.Frames
    Nix.Value.Core.Monad
    Nix.Value.Core.String
    Nix.Value.Core.Value
    Nix.Value.Core.Interned
    Nix.Value.Core.Equal
    Nix.Value.Core.Protocol
  hs-source-dirs:
    src
  build-depends:
      base >= 4.12 && < 5
    , aeson >= 1.4.2
    , comonad >= 5.0.8
    , deepseq >= 1.4.3
    , exceptions >= 0.10.0
    , free >= 5.1
    , hashable >= 1.2.5
    , hnix-types
    , hnix-attrset-sig
    , hnix-list-sig
    , hnix-string-sig
    , hnix-core
    , lens-family >= 1.2.2
    , lens-family-core >= 1.2.2
    , lens-family-th >= 0.5.0.2
    , mtl >= 2.2.2
    , ref-tf >= 0.5
    , reflection >= 2.1.6
    , relude >= 1.0.0
    , semialign >= 1.2
    , text >= 1.2.3
    , these >= 1.1
    , transformers >= 0.5.5
    , unordered-containers >= 0.2.14
  ghc-options:
    -Wall
    -Wno-incomplete-uni-patterns
