cabal-version:  3.0
name:           hnix-types
version:        0.17.0
synopsis:       Shared types for HNix Backpack packages
description:    Core types shared across all HNix packages: VarName, Path, NSourcePos, NAtom.
category:       System, Data, Nix
license:        BSD-3-Clause
license-file:   ../License
build-type:     Simple

flag strict
  description: Enable Strict language extension globally
  manual: True
  default: True

library
  default-language: Haskell2010
  default-extensions:
      NoImplicitPrelude
    , OverloadedStrings
    , DeriveGeneric
    , DeriveDataTypeable
    , DeriveFunctor
    , DeriveFoldable
    , DeriveTraversable
    , DeriveLift
    , FlexibleContexts
    , FlexibleInstances
    , ScopedTypeVariables
    , StandaloneDeriving
    , TypeApplications
    , TypeSynonymInstances
    , InstanceSigs
    , MultiParamTypeClasses
    , TupleSections
    , LambdaCase
    , BangPatterns
    , ViewPatterns
  if flag(strict)
    default-extensions:
      Strict
  exposed-modules:
    Nix.Types.Path
    Nix.Types.VarName
    Nix.Types.SourcePos
    Nix.Types.Atom
  hs-source-dirs:
    src
  build-depends:
      base >= 4.12 && < 5
    , aeson >= 2.0
    , binary >= 0.8.5
    , data-default-class >= 0.1.2
    , deepseq >= 1.4.3
    , filepath >= 1.4.2
    , hashable >= 1.2.5
    , megaparsec >= 7.0
    , relude >= 1.0.0
    , serialise >= 0.2.1
    , symbolize >= 1.0.0
    , template-haskell >= 2.13
    , text >= 1.2.3
  ghc-options:
    -Wall
    -Wno-incomplete-uni-patterns
