cabal-version:  3.0
name:           hnix-builtins-attrset
version:        0.17.0
synopsis:       AttrSet builtins for HNix using abstract attrset signature
description:    Provides Nix attrset builtins (hasAttr, getAttr, attrNames,
                attrValues, mapAttrs, etc.) using the abstract Nix.AttrSet.Sig
                signature and concrete NValue from hnix-value-core. GHC
                monomorphizes the attrset operations at link time.
                .
                This package requires one signature to be filled:
                .
                * Nix.AttrSet.Sig - provides the AttrSet type and operations
                .
                At instantiation time in main hnix, this signature is filled
                with hnix-attrset-hashmap.
category:       System, Data, Nix
license:        BSD-3-Clause
license-file:   ../License
build-type:     Simple

flag strict
  description: Enable Strict language extension globally
  manual: True
  default: True

library
  default-language: Haskell2010
  default-extensions:
      NoImplicitPrelude
    , OverloadedStrings
    , DeriveGeneric
    , DeriveFunctor
    , DeriveFoldable
    , DeriveTraversable
    , FlexibleContexts
    , FlexibleInstances
    , ScopedTypeVariables
    , TypeApplications
    , LambdaCase
    , BangPatterns
    , ConstraintKinds
    , AllowAmbiguousTypes
  if flag(strict)
    default-extensions:
      Strict
  -- Backpack signatures this package requires (to be filled at instantiation)
  -- Note: String.Sig is required transitively from hnix-value-core
  signatures:
    Nix.AttrSet.Sig
    Nix.String.Sig
  exposed-modules:
    Nix.Builtins.AttrSet
  hs-source-dirs:
    src
  build-depends:
      base >= 4.12 && < 5
    , exceptions >= 0.10.0
    , hnix-attrset-sig
    , hnix-list-sig
    , hnix-string-sig
    , hnix-types
    , hnix-value-core
    , relude >= 1.0.0
    , text >= 1.2
  ghc-options:
    -Wall
    -Wno-name-shadowing
