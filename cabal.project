semaphore: true
jobs: $ncpus
optimization: 1

-- profiling: true

package *
  -- profiling-detail: none
  ghc-options:
    -fobject-determinism

packages:
  .
  -- Backpack packages
  ./hnix-types
  ./signatures/hnix-attrset-sig
  ./signatures/hnix-list-sig
  ./signatures/hnix-value-protocol-sig
  ./implementations/hnix-attrset-hashmap
  ./implementations/hnix-list-vector
  ./hnix-core
  ./hnix-instantiated
  -- hnix-store packages
  ./hnix-store/hnix-store-core
  ./hnix-store/hnix-store-db
  ./hnix-store/hnix-store-json
  ./hnix-store/hnix-store-nar
  ./hnix-store/hnix-store-readonly
  ./hnix-store/hnix-store-remote
  ./hnix-store/hnix-store-tests

-- Performance testing packages
source-repository-package
  type: git
  location: https://github.com/nomeata/inspection-testing.git
  tag: 0.6.2
  --sha256: sha256-6b2g/mH5NG6HGdmQJGwUWYfZo9/xJZd7EgoMi1utfCc=

source-repository-package
  type: git
  location: https://github.com/fpco/weigh.git
  tag: 0.0.18
  --sha256: sha256-URsFBx01N1WlCZcy1LBQQ4M4NqBVAzLTA9FwVzPVSJc=
